{"_data": [{"contents": [{"content": "A Quick Coffee Break", "type": "lesson_name"}, {"content": "Restaurant Tales", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B1.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use important information about people's jobs and places of work in communicative situations.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn6le10ob05re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "tale", "type": "name"}, {"content": "a story about imaginary events", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The cook remembered some of her restaurant tales.", "type": "example"}, {"content": "engenn6le10ob05aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use when you tell stories about work.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to realize", "type": "name"}, {"content": "to understand or become aware of something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: They were able to realize he used the wrong vegetables.", "type": "example"}, {"content": "engenn6le10ob05aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to substitute", "type": "name"}, {"content": "to use something in place of something else", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: He realized it was a mistake to substitute the vegetables.", "type": "example"}, {"content": "engenn6le10ob05aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "awful", "type": "name"}, {"content": "really bad", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: She felt the cook's mistake was awful.", "type": "example"}, {"content": "engenn6le10ob05aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to make a mess", "type": "name"}, {"content": "to cause something to get dirty", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: She was glad not to make a mess of things in her job.", "type": "example"}, {"content": "engenn6le10ob05aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to admit", "type": "name"}, {"content": "to realize or accept the truth about something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The cook was able to admit his mistakes to the boss.", "type": "example"}, {"content": "engenn6le10ob05aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to deduct", "type": "name"}, {"content": "to take away something from the total", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: She never had any penalty deducted from her paycheck.", "type": "example"}, {"content": "engenn6le10ob05aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Showing Interest, Enthusiasm, and Sympathy", "type": "heading"}, {"content": "You use certain expressions to show interest at what someone is talking about.<br>There are expressions to show that you are enthusiastic about an idea.<br>There are also expressions to show sympathy at some sad news or someone's feelings.", "type": "describer"}, {"content": "The following table contain examples of expressions that show interest, enthusiasm, or surprise.", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Interest</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Please do tell.<br> Then what happened? <br>Hey, what's going on?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Enthusiasm</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Wow! That's great.<br> Awesome. Let's do it.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Sympathy</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Oh, that's too bad. <br>Oh, that's unfortunate.<br> Oh, that must be difficult. <br>I'm sorry to hear that.</span>\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "What I Didn't or Haven't Done!", "type": "heading"}, {"content": "When talking about actions that you have never done you need or you never did when you had the opportunity, you need to use <span class=\"strong\">Simple Past</span> and <span class=\"strong\">Present Perfect</span> in <span class=\"italic\">negative</span>. ", "type": "describer"}, {"content": "Remember you use <span class=\"strong\">Simple Past</span> to talk about finished actions in a specific time. And you use <span class=\"strong\">Present Perfect</span> to talk about actions that started in the past and haven't finished or are still related to the present. ", "type": "text"}, {"content": "{\"rows\":4,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Simple Past</span> in negative:    Subject + auxiliary + NOT + <span class=\\\"italic\\\">verb in base form</span> + complement <br><br>  <span class=\\\"strong\\\">\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  I/you/they/we/he/she + <span class=\\\"strong\\\">did</span> + not  (didn't) + <span class=\\\"italic\\\">infinitive</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  I/you/they/we + <span class=\\\"strong\\\">were</span> + not  (weren't)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  He/she/it + <span class=\\\"strong\\\">was</span> + not  (wasn't)\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": " The customers <span class=\"strong\">did</span><span class=\"italic\">n't notice</span> the difference.", "type": "example"}, {"content": "They <span class=\"strong\">did</span><span class=\"italic\">n't deduct</span> my payment. ", "type": "example"}, {"content": " The taste <span class=\"strong\">was</span><span class=\"italic\">n't</span> bad. ", "type": "example"}, {"content": "They <span class=\"strong\">were</span></span><span class=\"italic\">n't</span> here 2 weeks ago. ", "type": "example"}, {"content": "{\"rows\":4,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"strong\\\">Present Perfect</span> in negative Form: Subject + auxiliary + NOT + <span class=\\\"italic\\\">verb in past participle</span> + complement \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  I/you/we/they + <span class=\\\"strong\\\">have</span> + NOT (haven't) + <span class=\\\"italic\\\">verb in past participle</span> + complement \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"She/he/it + <span class=\\\"strong\\\">has</span> + NOT (hasn't) + <span class=\\\"italic\\\">verb in past participle</span> + complement \\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": " I <span class=\"strong\">have</span><span class=\"italic\">n't made</span> a mess like that in my new job.", "type": "example"}, {"content": "The new cook <span class=\"strong\">has</span><span class=\"italic\">n't admitted</span> his mistake.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Think about a major mistake you have made at work or at school.", "type": "text"}, {"content": "Write at least 8 sentences about what happened. ", "type": "text"}, {"content": "Use present perfect tense and simple past tense.", "type": "text"}, {"content": "Read your story to your partner. Ask your partner to tell you in English about a similar experience.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I express in my writing an experience I have had.", "type": "text"}, {"content": "I use the proper action words in my writing.", "type": "text"}, {"content": "I read my story to my partner.", "type": "text"}, {"content": "I listen to my partner's story.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn6le10ob05re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn6le10ob05re2img05.jpg", "time": "100", "id": 1, "text": "<span class = \"strong\">Vanessa</span>: You wouldn't believe what happened the other day.<br/>\n<span class = \"strong\">Sally</span>: Ooh, tales from the restaurant's back kitchen - please do tell.<br/>\n<span class = \"strong\">Vanessa</span>: One cook who's only been here for a week made this pot of stew. No one realized that he substituted the wrong vegetable. It made the whole pot turn orange!"}, {"image": "engenn6le10ob05re2img06.jpg", "time": "17500", "id": 2, "text": "<span class = \"strong\">Sally</span>: Oh, my gosh. How awful! Then what happened? <br/>\n<span class = \"strong\">Vanessa</span>: Well, it tasted different but it wasn't bad. So we served it, but the customers didn't notice the difference. <br/>\n<span class = \"strong\">Sally</span>: Well, I'm glad I haven't made a mess like that in my new job. <br/>\n<span class = \"strong\">Vanessa</span>: Well, I've made my share of mistakes. That new cook has admitted to his mistake, and he promised to be more careful."}, {"image": "engenn6le10ob05re2img06.jpg", "time": "38000", "id": 3, "text": "<span class = \"strong\">Sally</span>: Have any chefs or waiters dropped food?<br/>\n<span class = \"strong\">Vanessa</span>: Oh, of course. Each of them has done that at least once. <br/>\n<span class = \"strong\">Sally</span>: Oh, that's unfortunate. I haven't had my pay deducted for a mistake. Have you?<br/>\n<span class = \"strong\">Vanessa</span>: Well, they could've once when I made a mistake with a dish, but they didn't."}], "audiosrc": "engenn6le10ob05re2aud01", "coverimg": "engenn6le10ob05re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about jobs and work.", "type": "Learning Outcomes"}, {"content": " I can show interest, enthusiasm and sympathy.", "type": "Learning Outcomes"}, {"content": " I can discuss experiences I've had or haven't had.", "type": "Learning Outcomes"}, {"content": " Do you know someone who works in a restaurant?", "type": "Free Header Item"}, {"content": " Have you heard of any mistakes happening in a restaurant? What are they?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "What happens behind the scenes?", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": " \n\nVanessa tells Sally what happens behind the scenes.\n", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "