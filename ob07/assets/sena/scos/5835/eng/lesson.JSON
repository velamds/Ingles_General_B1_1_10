{"_data": [{"contents": [{"content": "A Quick Coffee Break", "type": "lesson_name"}, {"content": "From the Editing Room", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B1.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use important information about people's jobs and places of work in communicative situations.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn6le10ob07re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "to paraphrase", "type": "name"}, {"content": "to say something that someone else has said or written, using different words", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: She can paraphrase some of the customer comments.", "type": "example"}, {"content": "engenn6le10ob07aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use to discuss work.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "documentary", "type": "name"}, {"content": "a program that tells the facts about actual people and events", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The intern hasn't written a documentary piece before.", "type": "example"}, {"content": "engenn6le10ob07aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "privilege", "type": "name"}, {"content": "a special opportunity to do something that makes you proud", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: She had the privilege of experiencing rich cultures.", "type": "example"}, {"content": "engenn6le10ob07aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "outline", "type": "name"}, {"content": "a written list or description of only the most important parts of things such as an essay, a speech, or a plan.", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The editor suggested that the new girl write up an outline for the travel series.", "type": "example"}, {"content": "engenn6le10ob07aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "series", "type": "name"}, {"content": "a number of things or events that are arranged or happen one after the other", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: She had a plan for a travel series for the newspaper.", "type": "example"}, {"content": "engenn6le10ob07aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "revision", "type": "name"}, {"content": "a change or a set of changes that corrects or improves something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: She worked on writing her revisions for her editor.", "type": "example"}, {"content": "engenn6le10ob07aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "The Present Perfect Tense vs. The Simple Past Tense", "type": "heading"}, {"content": "When you talk about an action or an event that occurred in the past, but you do not specify when it occurred (maybe it's not relevant to say when it happened), you use the <span class=\"strong\">PRESENT PERFECT</span>. </br>When you want to say when an action or an event occurred at a specific time in the past, you use the <span class=\"strong\">SIMPLE PAST</span>.  </br>We have some time expressions for <span class=\"strong\">PRESENT PERFECT</span> which refers to indefinite time and some for <span class=\"strong\">SIMPLE PAST</span> which refers to definite time.", "type": "describer"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"PRESENT PERFECT \u2013 indefinite   \\\"}\",\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I <span class=\\\"strong\\\">have done</span> it\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"for a long time</br>lately</br>since this morning</br>before</br>recently\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"PAST SIMPLE -definite\\\"}\",\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I did it\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"yesterday.</br>last night.</br>three days ago.</br>at 8:30 p.m.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "I have read that book before.", "type": "example"}, {"content": "I ate chicken for dinner last night.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "<span class=\"italic\">Had better</span> and <span class=\"italic\">Ought to</span> for What is Advisable", "type": "heading"}, {"content": "You use the modal <span class=\"italic\">had better</span> and <span class=\"italic\">ought to</span> to give advice. You can also use <span class=\"italic\">had better</span> to express a strong suggestion.<br>You can use the contraction <span class=\"italic\">\u201c'd better\u201d</span> when you speak.", "type": "describer"}, {"content": "<span class=\"italic\">Ought to</span> is used to express a strong request or advice.<br><span class=\"italic\">You ought to write about those experiences in our travel section.</span>", "type": "text"}, {"content": "<span class=\"italic\">Might want to</span> is used to express a recommendation.<br><span class=\"italic\">You might want to make some changes to your article.</span>", "type": "text"}, {"content": "<span class=\"italic\">Had better</span> can be used as a strong recommendation, or warning.<br><span class=\"italic\">You'd better go and make those revisions.</span>", "type": "text"}], "type": "learning_points"}, {"contents": [{"content": "Write a review of 4 sentences for a restaurant in your city that you really did not like. ", "type": "text"}, {"content": "Write advice statements to your partner about the restaurant.", "type": "text"}, {"content": "Give the advice verbally to your partner about the restaurant.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write a review about a restaurant.", "type": "text"}, {"content": "I write advice statements.", "type": "text"}, {"content": "I give advice verbally to my partner.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn6le10ob07re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn6le10ob07re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Kerry</span>: Hi, Sally. I wanted to chat with you about the article you wrote on new restaurants in Cambridge. <br>\n<span class=\"strong\">Sally</span>: Yes, how was it?<br>\n<span class=\"strong\">Kelly</span>: Well, it's a bit too long. It'd be advisable to make some revisions.<br>\n<span class=\"strong\">Sally</span>: Absolutely. I can certainly paraphrase some of the customer comments. <br>\n<span class=\"strong\">Kerry</span>: That would be a good idea."}, {"image": "engenn6le10ob07re2img07.jpg", "time": "18500", "id": 2, "text": "<span class=\"strong\">Sally</span>: I haven't written a documentary piece before. I've mostly blogged on various adventures.<br>\n<span class=\"strong\">Kerry</span>: I've read some of your travel blogs. I liked them a lot. They were full of interesting facts about other countries and cultures.<br>\n<span class=\"strong\">Sally</span>: Well, thank you. I've had the privilege of experiencing these rich cultures."}, {"image": "engenn6le10ob07re2img07.jpg", "time": "37000", "id": 3, "text": "<span class=\"strong\">Kerry</span>: You ought to write about those experiences in our travel section.<br>\n<span class=\"strong\">Sally</span>: For sure. I can compose a plan for a travel series.<br>\n<span class=\"strong\">Kerry</span>: Wonderful. Why don't you write up an outline? Then we can present to the editor at our staff meeting next Monday.<br>\n<span class=\"strong\">Sally</span>: No problem. Well, I'd better go and make those revisions."}], "audiosrc": "engenn6le10ob07re2aud01", "coverimg": "engenn6le10ob07re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about jobs and work. ", "type": "Learning Outcomes"}, {"content": " I can discuss experiences I've had or haven't had. ", "type": "Learning Outcomes"}, {"content": " I can offer advice and solutions.", "type": "Learning Outcomes"}, {"content": " What are some your favorite restaurants where you live?", "type": "Free Header Item"}, {"content": "What makes these restaurants special? What do they offer?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Discussions at the workplace can be difficult.", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": " \nSally has a discussion with a colleague about her work.\n", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is mi