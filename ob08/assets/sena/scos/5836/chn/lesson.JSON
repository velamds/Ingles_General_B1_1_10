selected": 0, "_data": [{"type": "audio", "content": "engenn6le10ob08re6aud10"}], "text": "", "id": 1}, {"correct": 0, "selected": 0, "_data": [{"type": "audio", "content": "engenn6le10ob08re6aud11"}], "text": "", "id": 2}, {"correct": 0, "selected": 0, "_data": [{"type": "audio", "content": "engenn6le10ob08re6aud12"}], "text": "", "id": 3}], "id": 0, "_data": [{"contents": [{"type": "text", "content": "Which sentence talks about family life?"}], "type": "question"}, {"type": "objective", "content": "secondary_8"}]}], "type": "DMC", "id": 10, "_data": [{"contents": [{"type": "text", "content": " \nCollette and Sue chat over coffee.\n"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "text", "content": "\nInstructions: Listen to the audio. Select the correct answer.\n"}], "type": "post_instructions"}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le10ob08re2img01.jpg", "audiosrc": "engenn6le10ob08re2aud01", "images": [{"time": "0", "image": "engenn6le10ob08re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le10ob08re2img01.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>: Thank you for letting me chat with you for <span class=\"italic\">Cambridge Life</span> magazine. I haven't had the opportunity to meet a gentleman of your age. You would have seen a lot. <br>\n<span class=\"strong\">Tom</span>: I have seen a lot in my 100 years.<br>"}, {"time": "12000", "image": "engenn6le10ob08re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Sally</span>: I heard that you were in the Second World War.  <br>\n<span class=\"strong\">Tom</span>:  Yes, I was only 18 when I had to leave my family. I was part of the Western Front, you know.<br>\n<span class=\"strong\">Sally</span>: You were very brave. How long were you there?<br>\n<span class=\"strong\">Tom</span>: Six months. The stress of combat was overwhelming, so I started smoking. Thank goodness I quit the nasty habit 30 years ago. I used to smoke a pack a day.<br>"}, {"time": "38500", "image": "engenn6le10ob08re2img01.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: When did you return home?<br>\n<span class=\"strong\">Tom</span>:  In 1945. I married my childhood sweetheart, Anne. Our twin boys, Robert and James, were born a couple years later. We later adopted Samuel, Grace and Albert.<br>\n<span class=\"strong\">Sally</span>: You have a large family!<br>\n<span class=\"strong\">Tom</span>: Yes, they are now grown with families of their own.  <br>"}, {"time": "60500", "image": "engenn6le10ob08re2img01.jpg", "id": 4, "text": "<span class=\"strong\">Sally</span>: You must eat well and exercise. What's your secret?<br>\n<span class=\"strong\">Tom</span>: I haven't had much illness in my later years. I believe in fresh air, a daily walk and a nice glass of port before bedtime.<br>\n<span class=\"strong\">Sally</span>: You've had some interesting experiences in your life."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "5000", "image": "", "id": 0, "text": "Here are some examples of habits:<ul><li>smoking habits</li><li>sleeping habits</li><li>eating habits</li><li>study habits</li></ul>"}, {"time": "60500", "image": "", "id": 1, "text": "Here are some examples of sentences of using <span class=\"italic\">have had</span> and <span class=\"italic\">haven't had</span>:\n<span class=\"italic\"><ul><li>I haven't had much illness in my later years.</li>\n<li>I haven't had the opportunity to meet a gentleman of your age.</li>\n<li>You've had some wonderful experiences in your life.</li></ul></span>"}], "video_src": "engenn6le10ob08re3vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 2, "_data": []}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "A Quick Coffee Break"}, {"type": "unit_name", "content": "An Afternoon With Mr. Sims"}, {"type": "position", "content": 8}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 10}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe past experiences in a range of social and work contexts."}, {"type": "secondary_1", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_2", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_3", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations  Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_5", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_6", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le10ob08re1img01.jpg"}, {"contents": [{"type": "name", "content": "Western Front "}, {"type": "definition", "content": "A name used to describe where militaries met in the World Wars."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I was part of the Western Front in 1943."}, {"type": "audio", "content": "engenn6le10ob08aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you hear in a conversation about the past."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "combat"}, {"type": "definition", "content": "active fighting"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:The stress of combat was overwhelming, so I started smoking. "}, {"type": "audio", "content": "engenn6le10ob08aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "nasty"}, {"type": "definition", "content": "very unpleasant to see, smell, taste, etc."}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Smoking is a nasty habit."}, {"type": "audio", "content": "engenn6le10ob08aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "port"}, {"type": "definition", "content": "a strong, sweet, usually dark red wine that is made in Portugal"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I always have a glass of port before bed."}, {"type": "audio", "content": "engenn6le10ob08aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to adopt "}, {"type": "definition", "content": "to take a child of other parents legally as your own child"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I adopted three children."}, {"type": "audio", "content": "engenn6le10ob08aud05"}], "type": "target_word"}, {"contents": [{"type": "heading", "content": "Writing an Autobiography "}, {"type": "describer", "content": "To write an autobiography you need to follow the next steps:"}, {"type": "text", "content": "1. Write you name and personal information. (date and place of birth) <br> 2. Write about your family life. <br> 3. Write about some of the activities you usually like to do. <br> 4. Write about your most exciting experiences and challenges. <br> 5. Write about things you haven't done that you want to do in the future. <br><br>  <span class=\"strong\">Example:</span><br> <span class=\"italic\">My autobiography My name is Claire Feeney. I was born in Seattle in 1993. I studied in a nice and quiet school. I live in Seattle with my parents, my siblings and my grandmother. I also have a huge black dog. I love outdoors sports, I usually go hiking to Mount Rainier and sometimes I play baseball with my friends. I also love to travel. I have travelled to Turkey, Per\u00fa and Nigeria. I have eaten typical food from all those countries. I haven't visited Colombia yet but I would love to visit my penpal in Bogot\u00e1 some day because I haven't seen her in years.<span>"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Used to and Would for Past Habits"}, {"type": "describer", "content": "<span class=\"italic\">Would</span> and <span class=\"italic\">used to</span> have similar meanings. They are both used to describe something that happened regularly in the past but doesn't happen any longer."}, {"type": "text", "content": "However, there is an important difference between <span class=\"italic\">used to</span> and <span class=\"italic\">would</span>. <span class=\"italic\">Would</span> is not used unless you know that the time frame is in the past, while <span class=\"italic\">used to</span> does not require this."}, {"type": "example", "content": "I used to smoke a pack of cigarettes a day."}, {"type": "example", "content": "I used to eat unhealthy food. "}, {"type": "example", "content": "I would often go to bed after midnight."}], "type": "learning_points"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "You are a reporter for Cambridge Life.  You have to interview a friend of the family about their life."}, {"type": "text", "content": "Ask 6-8 questions."}, {"type": "text", "content": "Ask about their family, past habits and if they had or haven't had an interesting life."}, {"type": "text", "content": "Write down their answers in complete sentences."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I interview a family member."}, {"type": "text", "content": "I ask questions about family and past experiences."}, {"type": "text", "content": "I write sentences about the life of others."}]}]}