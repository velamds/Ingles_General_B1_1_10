{"_data": [{"contents": [{"content": "A Quick Coffee Break", "type": "lesson_name"}, {"content": "What I Learned", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B1.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe past experiences in a range of social and work contexts.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn6le10ob01re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "break", "type": "name"}, {"content": "a short time of rest to break up the workday", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The workers took a short coffee break.", "type": "example"}, {"content": "engenn6le10ob01aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use when you talk with colleagues.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "workday", "type": "name"}, {"content": "a day on which you work at a job", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He would write marketing plans on a typical workday.", "type": "example"}, {"content": "engenn6le10ob01aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to have a seat ", "type": "name"}, {"content": "to take a rest sitting down", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: She asked her friend to have a seat during their coffee break.", "type": "example"}, {"content": "engenn6le10ob01aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to survey", "type": "name"}, {"content": "to check out an area in search of something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Shoppers would survey the market for a certain product.", "type": "example"}, {"content": "engenn6le10ob01aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to come up with", "type": "name"}, {"content": "to discover the answer to something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: He would always come up with a strategy.", "type": "example"}, {"content": "engenn6le10ob01aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to find out", "type": "name"}, {"content": "to know for the first time; to realize", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: He wanted to find out the sales goals for his co-worker.", "type": "example"}, {"content": "engenn6le10ob01aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Present Perfect and Past Simple Tenses", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "You use the <span class=\"strong\">Present Perfect</span> tense to talk about an action or event that is connected to the present in some way.<br><br>   You use the <span class=\"strong\">Simple Past</span> tense to talk about a finished action or event not connected to the present. <br><br>  When you use the <span class=\"strong\"> Present Perfect </span> tense, there is a connection between what happened in the past and now. You can use time markers like <span class=\"italic\">for, just</span> and <span class=\"italic\">ever</span>. <br><br>  When you use the <span class=\"strong\"> Simple Past </span> tense, the time is always in the past. You can use time markers like: <span class=\"italic\">then, ago, yesterday, when I was \u2026</span> <br><br>  Look at the chart to see how to form the <span class=\"strong\"> Present Perfect </span> tense:", "type": "text"}, {"content": "{\"rows\":6,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Base form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past tense form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present Perfect form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"try\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"tried\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"has/have tried\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I have tried to cut down on the amount of coffee I drink.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"do\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"did\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"has/have done\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I haven't done this type of project before.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"be\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"has/have been\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">How has your job been?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"learn\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"learned\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"has/have learned\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I have learned a lot from my colleagues here.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "Habits of the Past", "type": "heading"}, {"content": "<span class=\"italic\">Used to</span> and <span class=\"italic\">would</span> express a pattern of action that occurred regularly in the past.", "type": "describer"}, {"content": "Both <span class=\"italic\"> used to </span>  and <span class=\"italic\"> would </span>  are followed by the base form of the verb.", "type": "text"}, {"content": "Subject + <span class=\"italic\">used to</span> + verb <br/><span class=\"italic\">I used to take a walk everyday.</span>", "type": "text"}, {"content": "Subject + <span class=\"italic\">would</span> + verb <br/><span class=\"italic\">I would walk 3 miles every evening</span>.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Used to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Would\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I used to make myself a cappuccino every morning.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I would get up a little earlier to heat up the machine.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I used to have 6 cups of coffee during the workday.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Every hour I would go back for another cup.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I used to write marketing plans.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I would survey the market for that product.<br>I would find out the sales goals.<br>I would come up with a strategy. </span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "Write down 3 new things you have experienced in the last 2 years.", "type": "text"}, {"content": "Write down 3 things you have stopped doing in the last 2 years.", "type": "text"}, {"content": "Use Present Perfect tense in your sentences.", "type": "text"}, {"content": "Read your 6 sentences to your partner. Ask them about their experiences.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write complete statements on new experiences.", "type": "text"}, {"content": "I name some habits I have stopped. ", "type": "text"}, {"content": "I exchange ideas about experiences with my partner.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn6le10ob01re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn6le10ob01re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Brad</span>: Hey, Peter. How are things?<br>\n<span class=\"strong\">Peter</span>: Not too bad, Brad. Want a coffee?<br>\n<span class=\"strong\">Brad</span>: Sure. It's nice to have a break in the middle of the morning. <br>\n<span class=\"strong\">Peter</span>: Yeah, I used to make myself a cappuccino every morning, but these days I don't give myself enough time.<br>\n<span class=\"strong\">Brad</span>: I used to consume 6 cups of coffee during the workday. I've tried to cut down. Have a seat. So how's your job been?"}, {"image": "engenn6le10ob01re2img01.jpg", "time": "24000", "id": 2, "text": "<span class=\"strong\">Peter</span>: Pretty good. I've worked on a marketing strategy all morning. I haven't done this type of project before, so there is a bit of a learning curve.<br>\n<span class=\"strong\">Brad</span>: Oh, I used to write marketing plans, so I could help you. I would survey the market for that product. I would find out the sales goals, and then I would come up with a strategy. Consumers generally responded well."}, {"image": "engenn6le10ob01re2img05.jpg", "time": "46000", "id": 3, "text": "<span class=\"strong\">Peter</span>: Right on! The promotions I consulted on before weren't quite the same, but I've learned a lot from my colleagues here.<br>\n<span class=\"strong\">Brad</span>: Excellent! Well, I've had enough caffeine for the morning."}], "audiosrc": "engenn6le10ob01re2aud01", "coverimg": "engenn6le10ob01re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about jobs and work.", "type": "Learning Outcomes"}, {"content": " I can discuss experiences I've had or haven't had.", "type": "Learning Outcomes"}, {"content": " I can talk about people's past habits.", "type": "Learning Outcomes"}, {"content": " Do you have a coffee break during your workday or school day? When is it?", "type": "Free Header Item"}, {"content": " What do you chat with your friends about?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "It's fun to catch up with a colleague!", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": " \nPeter chats with a colleague over <span class=\"tool-tip\" id=\"tip_1_0\">coffee break</span>.\n", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"content": [{"content": " A <span class=\"italic\">\"coffee break\"</span> in many North American workplaces is usually 15 minutes twice a day.", "tip_id": 0, "type": "text"}], "type": "tips"}, {"contents": [{"content": "\nInstructions: Click on the play button to listen t