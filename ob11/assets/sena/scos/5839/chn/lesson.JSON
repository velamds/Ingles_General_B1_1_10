{"type": "sena", "_data": [{"contents": [{"type": "lesson_name", "content": "A Quick Coffee Break"}, {"type": "unit_name", "content": "Listen Up!"}, {"type": "position", "content": 11}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 10}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe past experiences in a range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"contents": [{"type": "name", "content": "awful"}, {"type": "definition", "content": "really bad"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Oh, what an awful month it has been!"}, {"type": "audio", "content": "engenn6le10ob11aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use when you talk about a change in your life."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "divorce"}, {"type": "definition", "content": "when a couple decides to end their marriage and live separately"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: My uncle and aunt have decided to get a divorce."}, {"type": "audio", "content": "engenn6le10ob11aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to end up"}, {"type": "definition", "content": "to reach or come to a place or situation that was not expected"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I've ended up with all this pressure from my new job. "}, {"type": "audio", "content": "engenn6le10ob11aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to run around"}, {"type": "definition", "content": "to go from place to place in a hurried way"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I used to run around from country to country and blog about my experiences. "}, {"type": "audio", "content": "engenn6le10ob11aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to adopt"}, {"type": "definition", "content": "to take or accept"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Now we've both adopted serious responsibilities."}, {"type": "audio", "content": "engenn6le10ob11aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to find out"}, {"type": "definition", "content": "to know for the first time; to realize"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I've found out how to balance my intake of vegetables, carbs and protein."}, {"type": "audio", "content": "engenn6le10ob11aud06"}], "type": "target_word"}, {"contents": [{"type": "heading", "content": "Present Perfect and Past Simple Tenses"}, {"type": "describer", "content": "This section will help you to understand the differences between the Present Perfect Tense and the Simple Past Tense. "}, {"type": "text", "content": "<span class=\"strong\">Has the time period finished?</span>"}, {"type": "table", "content": "{\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">present perfect</span> is used when the time period has NOT finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">have seen</span>  three movies this week.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"This week has not finished yet.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">simple past</span> is used when the time period HAS finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">saw</span> three movies last week.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Last week has finished.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "<span class=\"strong\">Is it new information or old?</span>"}, {"type": "table", "content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">present perfect</span> is often used when giving recent news.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Martin <span class=\\\"strong\\\">has crashed</span> his car again.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"This is new information.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">simple past</span> is used when giving older information.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Martin <span class=\\\"strong\\\">crashed</span> his car last year.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"This is old information.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "<span class=\"strong\">Is it a specific time? </span>"}, {"type": "table", "content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">present perfect</span> is used when the time is not specific.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">have seen</span> that movie already.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We don't know when.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">simple past</span> is used when the time is clear.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">saw</span> that movie on Thursday.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We know exactly when.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "text", "content": "<span class=\"strong\">Has the action finished (sentences with \u201cfor\u201d or \u201csince\u201d)?</span>"}, {"type": "table", "content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">present perfect</span> is used with for and since when the actions have not finished yet.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">have lived</span> in Victoria for five years.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I still live in Victoria.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The <span class=\\\"strong\\\">simple past</span> is used with for when the actions have already finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">lived</span> in Victoria for five years.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I don't live in Victoria now.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "<span class=\"italic\">Used to</span>  and <span class=\"italic\">Would</span> for Past Habits"}, {"type": "describer", "content": "<span class=\"italic\">Used to</span>  and <span class=\"italic\">would</span> have similar meanings. They are both used to describe something that happened regularly in the past but doesn't happen any longer.<br><br>However, there is an important difference between <span class=\"italic\">used to</span>  and <span class=\"italic\">would</span> ."}, {"type": "text", "content": "<span class=\"italic\">Would</span> is not used unless you know that the time frame is in the past, while <span class=\"italic\">used to</span> does not require this."}, {"type": "text", "content": "Both <span class=\"italic\">used to</span> and <span class=\"italic\">would</span> are followed by a verb in the base form."}, {"type": "text", "content": "Subject + <span class=\"italic\">used to</span>  + verb<br><span class=\"italic\">My father used to take me to the park."}, {"type": "text", "content": "Subject + <span class=\"italic\">would</span>  + verb<br><span class=\"italic\">My grandfather and I would go to the library once a week, and he would help me pick out a book."}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Used to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Would\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Life used to be so stress-free and adventurous.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I would just travel and blog about my experiences.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">My parents and I used to have regular visits.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">They would come in to town once a week.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">My father used to eat a lot of dishes high in fat.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">He would eat that for dinner almost every day.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}], "type": "learning_points"}, {"type": "background_image", "content": "engenn6le10ob11re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a dialogue with your partner about a stressful month that you've had."}, {"type": "text", "content": "Think of incidents you've both experienced that made the month stressful."}, {"type": "text", "content": "Use verbs to express what has happened."}, {"type": "text", "content": "Practice the dialogue several times with your partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write a dialogue together with a partner."}, {"type": "text", "content": "I use proper forms of action words to express what has happened."}, {"type": "text", "content": "I practice speaking with my partner."}]}], "labs": [{"exercises": [{"template_override": 1, "stimuli_ids": [0], "img_path": "", "questions": [], "type": "WLC", "id": 0, "_data": [{"contents": [{"type": "Learning Outcomes", "content": " I can talk about family life and work. "}, {"type": "Learning Outcomes", "content": " I can talk about people's past habits. "}, {"type": "Learning Outcomes", "content": " I can discuss experiences I've had or haven't had."}, {"type": "Free Header Item", "content": " Do you remember a time when a big change happened in your life?"}, {"type": "Free Header Item", "content": "What habits have you adopted lately?"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Welcome"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": "You have 2 tries"}, {"type": "text", "content": "you have 1 attempt left"}], "correct_feedback": "Correct", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "try again"}, {"typ