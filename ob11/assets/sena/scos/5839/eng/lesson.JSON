{"_data": [{"contents": [{"content": "A Quick Coffee Break", "type": "lesson_name"}, {"content": "Listen Up!", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "B1.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe past experiences in a range of social and work contexts.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "awful", "type": "name"}, {"content": "really bad", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Oh, what an awful month it has been!", "type": "example"}, {"content": "engenn6le10ob11aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use when you talk about a change in your life.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "divorce", "type": "name"}, {"content": "when a couple decides to end their marriage and live separately", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: My uncle and aunt have decided to get a divorce.", "type": "example"}, {"content": "engenn6le10ob11aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to end up", "type": "name"}, {"content": "to reach or come to a place or situation that was not expected", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I've ended up with all this pressure from my new job. ", "type": "example"}, {"content": "engenn6le10ob11aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to run around", "type": "name"}, {"content": "to go from place to place in a hurried way", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I used to run around from country to country and blog about my experiences. ", "type": "example"}, {"content": "engenn6le10ob11aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to adopt", "type": "name"}, {"content": "to take or accept", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Now we've both adopted serious responsibilities.", "type": "example"}, {"content": "engenn6le10ob11aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to find out", "type": "name"}, {"content": "to know for the first time; to realize", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I've found out how to balance my intake of vegetables, carbs and protein.", "type": "example"}, {"content": "engenn6le10ob11aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Present Perfect and Past Simple Tenses", "type": "heading"}, {"content": "It is important that you understand the differences between the Present Perfect Tense and the Simple Past Tense. ", "type": "describer"}, {"content": "<span class=\"strong\"> Ask yourself if the time period has finished</span>", "type": "text"}, {"content": "{\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You use the <span class=\\\"strong\\\">present perfect</span> when the specific time is not mentioned or when it is connected to the present.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">have eaten</span>  three cupcakes this morning.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It is still morning now.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" You use the <span class=\\\"strong\\\">simple past</span> for an action in the past that has finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">ate</span> three cupcakes last night.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Last night has finished.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "</br> </br><span class=\"strong\">Ask yourself if the information is new or old</span>", "type": "text"}, {"content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You can use the <span class=\\\"strong\\\">present perfect</span> when you talk about recent news.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Trevor <span class=\\\"strong\\\">has lost</span> his wallet again.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"This information is recent or new.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You can use the <span class=\\\"strong\\\">simple past</span>  when you talk about older information.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Trevor <span class=\\\"strong\\\">lost</span> his wallet last week.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"This information is old and is not connected to the present. \\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "</br> </br> <span class=\"strong\">Ask yourself if you are referring to a specific time </span> ", "type": "text"}, {"content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You use the <span class=\\\"strong\\\">present perfect</span> when the time is unspecified.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Bob<span class=\\\"strong\\\"> has finished</span> his degree already.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You don't know when he finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You use the <span class=\\\"strong\\\">simple past</span> when the time in the past is specific.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Bob <span class=\\\"strong\\\">finished</span> his degree in May.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You know exactly when he finished.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "</br> </br> <span class=\"strong\">Ask yourself if the action finished in sentences with \u201cfor\u201d or \u201csince\u201d</span>", "type": "text"}, {"content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Rule\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You use the <span class=\\\"strong\\\">present perfect</span> with <span class=\\\"italic\\\">for</span> and <span class=\\\"italic\\\">since</span> when the action are not finished yet. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">We <span class=\\\"strong\\\">have studied</span> in Santa Fe for five years.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We still study in Santa Fe.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You use the <span class=\\\"strong\\\">simple past</span> when the action has  finished. It has no connection to the present.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">We <span class=\\\"strong\\\">studied</span> in Santa Fe in 2007.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We don't study in Santa Fe now.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "<span class=\"italic\">Used to</span>  and <span class=\"italic\">Would</span> for Past Habits", "type": "heading"}, {"content": "<span class=\"italic\">Used to</span>  and <span class=\"italic\">would</span> have similar meanings. They are both used to describe something that happened regularly in the past but doesn't happen any longer.<br><br>However, there is an important difference between <span class=\"italic\">used to</span>  and <span class=\"italic\">would</span> .", "type": "describer"}, {"content": "<span class=\"italic\">Would</span> is not used with stative verbs like <span class=\"italic\">love, hate, feel, understand.</span> ", "type": "text"}, {"content": "Both <span class=\"italic\">used to</span> and <span class=\"italic\">would</span> are followed by a verb in the base form.", "type": "text"}, {"content": "Subject + <span class=\"italic\">used to</span>  + verb<br><span class=\"italic\">My father used to take me to the park.", "type": "text"}, {"content": "Subject + <span class=\"italic\">would</span>  + verb<br><span class=\"italic\">My grandfather and I would go to the library once a week, and he would help me pick out a book.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Used to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Would\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Life used to be so stress-free and adventurous.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I would just travel and blog about my experiences.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">My parents and I used to have regular visits.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">They would come in to town once a week.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">My father used to eat a lot of dishes high in fat.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">He would eat that for dinner almost every day.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"content": "engenn6le10ob11re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Write a dialogue with your partner about a stressful month that you've had.", "type": "text"}, {"content": "Think of incidents you've both experienced that made the month stressful.", "type": "text"}, {"content": "Use verbs to express what has happened.", "type": "text"}, {"content": "Practice the dialogue several times with your partner.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write a dialogue together with a partner.", "type": "text"}, {"content": "I use proper forms of action words to express what has happened.", "type": "text"}, {"content": "I practice speaking with my partner.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn6le10ob11re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn6le10ob11re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Sally</span>: Oh, what a tumultuous month it has been! I have tried different stress management techniques.<br>\n<span class=\"strong\">Vanessa</span>: Oh, I'll say. Your uncle and aunt have decided to get a divorce. My father has gone into the hospital.<br>\n<span class=\"strong\">Sally</span>: I've encountered all this pressure from my new job.<br>\n<span class=\"strong\">Vanessa</span>: I've also had to navigate through all the relationship problems with Marco. The situation has improved though.<br>"}, {"image": "engenn6le10ob11re2img05.jpg", "time": "22000", "id": 2, "text": "<span class=\"strong\">Sally</span>: Yeah, I've learned to adjust to my job, too. <br>\n<span class=\"strong\">Vanessa</span>:  Life used to be so stress-free and adventurous when we were traveling. Remember? <br>\n<span class=\"strong\">Sally</span>: Oh, yeah. I would just go country to country and blog about my experiences. Now we've both adopted serious responsibilities.<br>\n<span class=\"strong\">Vanessa</span>: How's your diet going?<br>"}, {"image": "engenn6le10ob11re2img01.jpg", "time": "39500", "id": 3, "text": "<span class=\"strong\">Sally</span>: Oh, I've balanced my intake of vegetables, carbs and protein.  I used to just find whatever I could on the street for take-out, and I would eat till I was full. <br>\n<span class=\"strong\">Vanessa</span>: Since I have started working in the restaurant, good food has been accessible and free. So, each work day I would eat two meals a day at the restaurant.<br>\n<span class=\"strong\">Sally</span>:  Oh, lucky you!<br>\n<span class=\"strong\">Vanessa</span>: Yes, however, I've also consumed too many calories because most dishes are rich!"}], "audiosrc": "engenn6le10ob11re2aud01", "coverimg": "engenn6le10ob11re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about family life and work. ", "type": "Learning Outcomes"}, {"content": " I can talk about people's past habits. ", "type": "Learning Outcomes"}, {"content": " I can discuss experiences I've had or haven't had.", "type": "Learning Outcomes"}, {"content": " Do you remember a time when a big change happened in your life?", "type": "Free Header Item"}, {"content": "What habits have you adopted lately?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Let's review!", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": " \nIt's been a <span class=\"tool-tip\" id=\"tip_1_0\">rough</span> month for Vanessa and Sally.\n", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "\nInstructions: Click on the play button to listen to the audio.\n", "type": "text"}], "type": "post_instructions"}, {"contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}], "type": "learning_skills"}, {"content": [{"content": "<span class=\"italic\">\"Rough\"</span> is a synonym of  difficult when talking about experiences.", "tip_id": 0, "type": "text"}], "type": "tips"}], "questions": [{"_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}, {"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 1}]}], "type": "STI", "id": 1, "stimuli_ids": [1]}, {"template_override": 1, "_data": [{"contents": [{"content": " Write a dialogue about stressful times in your life.", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Take Away", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}], "type": "post_instructions"}], "questions": [{"_data": [{"contents": [{"content": "engenn6le10ob11re7pdf01.pdf", "type": "pdf"}], "type": "question"}], "id": 0, "responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}]}], "type": "DWS", "id": 2, "stimuli_ids": []}, {"template_override": 1, "_data": [{"contents": [{"content": " \nHow has life changed for Vanessa and Sally?\n", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Activity 1", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": " \nInstructions: Listen to the dialogue. Select the correct answer.\n", "type": "text"}, {"content": "You have 2 attempts to submit your answers.", "type": "text"}, {"content": "engenn6le10ob11re2aud01", "type": "audio"}], "type": "post_instructions"}], "questions": [{"_data": [{"contents": [{"content": "Why has it been a rough month for Vanessa?", "type": "text"}], "type": "question"}, {"content": "secondary_1", "type": "objective"}], "id": 0, "responses": [{"correct": 1, "selected": 0, "_data": [{"content": "Her father has gone into hospital, and she started a new relationship with Marco. ", "type": "text"}], "id": 0}, {"correct": 0, "selected": 0, "_data": [{"content": "Her father has come out of hospital, and she has relationship problems with Marco. ", "type": "text"}], "id": 1}, {"correct": 0, "selected": 0, "_data": [{"content": "Her parents are getting a divorce, and her uncle is in hospital.", "type": "text"}], "id": 2, "text": ""}]}, {"_data": [{"contents": [{"content": "Why has it been a rough month for Sally?", "type": "text"}], "type": "question"}, {"content": "secondary_1", "type": "objective"}], "id": 1, "responses": [{"correct": 0, "selected": 0, "_data": [{"content": "She got a new job.", "type": "text"}], "id": 0}, {"correct": 0, "selected": 0, "_data": [{"content": "She had to blog about her new job. ", "type": "text"}], "id": 1}, {"correct": 1, "selected": 0, "_data": [{"content": "She had a lot of pressure in her new job.", "type": "text"}], "id": 2, "text": ""}]}, {"_data": [{"contents": [{"content": "How is work different for Sally now than what it used to be?", "type": "text"}], "type": "question"}, {"content": "secondary_1", "type": "objective"}], "id": 2, "responses": [{"correct": 1, "selected": 0, "_data": [{"content": "It was full of adventure before. Now it's full of responsibilities.", "type": "text"}], "id": 0}, {"correct": 0, "selected": 0, "_data": [{"content": "It was full of responsibilities before. Now it's full of adventure.", "type": "text"}], "id": 1}, {"correct": 0, "selected": 0, "_data